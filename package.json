{
  "name": "static-wordpress-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "fix": "eslint . --fix",
    "check": "pnpm run lint && pnpm run typecheck",
    "changeset": "changeset",
    "release": "pnpm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@stylistic/eslint-plugin": "^4.4.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-config-galexia": "git+https://github.com/Galexia-Agency/eslint-config.git#e94753a7ed8a94ae746f5f6ccf605ce288565ff2",
    "globals": "^17.0.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "^24.18.0",
    "pnpm": "^10.11.1"
  },
  "packageManager": "pnpm@10.11.1"
}
