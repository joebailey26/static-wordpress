{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "example-cms",
  "account_id": "0000",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-22",
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "routes": [{ "pattern": "cms.example.com", "custom_domain": true }],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "example-cms",
    "database_id": "production-db",
    "migrations_dir": "migrations"
  }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "example-cms-files" }],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "galexia.cloudflareaccess.com",
    "ACCESS_AUD": "production-aud",
    "CF_ACCOUNT_ID": "0000",
    "CF_WORKER_TAG": "site-worker",
    "SITE_BRANCH": "master"
  },
  "previews": {
    "d1_databases": [{
      "binding": "DB",
      "database_name": "example-cms-preview",
      "database_id": "preview-db",
      "migrations_dir": "migrations"
    }],
    "r2_buckets": [{ "binding": "FILES", "bucket_name": "example-cms-preview-files" }],
    "vars": {
      "ACCESS_TEAM_DOMAIN": "galexia.cloudflareaccess.com",
      "ACCESS_AUD": "preview-aud",
      "CMS_TRIGGER_BUILDS": "false"
    }
  },
  "triggers": { "crons": ["*/5 * * * *"] }
}
